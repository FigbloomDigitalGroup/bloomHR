{
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(attendance.*)", "destination": "/api" },
    { "source": "/api/(careers.*)", "destination": "/api" },
    { "source": "/iclock/(.*)", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "https://hr-api.figbloom.org/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
