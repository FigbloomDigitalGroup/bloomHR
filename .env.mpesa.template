# ============================================================================
# M-PESA CONFIGURATION
# ============================================================================
# Get these credentials from Safaricom Daraja Portal: https://developer.safaricom.co.ke/

# Consumer Key and Secret (from your Daraja App)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Initiator credentials (from Daraja)
MPESA_INITIATOR_NAME=your_initiator_name_here
MPESA_SECURITY_CREDENTIAL=your_security_credential_here

# M-Pesa Shortcode (Paybill or Till Number)
MPESA_SHORTCODE=your_shortcode_here

# ============================================================================
# CALLBACK URLs - These must be publicly accessible HTTPS URLs
# ============================================================================
# Replace 'https://mpesa-22p0.onrender.com' with your actual deployed backend URL
# or use ngrok for local testing

# B2C Payment Callbacks
MPESA_B2C_RESULT_URL=https://mpesa-22p0.onrender.com/api/mpesa/b2c-result
MPESA_B2C_QUEUE_TIMEOUT_URL=https://mpesa-22p0.onrender.com/api/mpesa/b2c-timeout

# Transaction Status Callbacks
MPESA_TRANSACTION_STATUS_RESULT_URL=https://mpesa-22p0.onrender.com/api/mpesa/transaction-status-result
MPESA_TRANSACTION_STATUS_QUEUE_TIMEOUT_URL=https://mpesa-22p0.onrender.com/api/mpesa/transaction-status-timeout

# ============================================================================
# NOTES:
# ============================================================================
# 1. All callback URLs MUST be HTTPS (not HTTP)
# 2. Safaricom will POST results to these URLs
# 3. Make sure your server is publicly accessible
# 4. For local testing, use ngrok: ngrok http 3001
#    Then update the URLs above with your ngrok URL
# 5. Register these URLs in Safaricom Daraja Portal

# ============================================================================
# PAYROLL PAYMENTS (FIG-744): paying approved payroll runs from the server
# ============================================================================
# The server running safaricom.js sends queued payroll payments. The M-Pesa worker starts once the M-Pesa settings
# above (including both B2C callback URLs) are set; until then M-Pesa payments wait in the queue.
# Set to "off" on any second server so only one sends.
PAYROLL_PAYMENTS_WORKER=on

# Largest single M-Pesa salary payment (KSh); staff above it are left out with a note to pay by bank.
# Confirm the limit for your shortcode with Safaricom.
PAYROLL_MPESA_MAX_AMOUNT=150000

# Bank payouts: the adapter in bank_providers/<name>.js for your bank (see bank_providers/README.md), plus that
# bank's own credentials. Leave empty until a bank is set up; bank payments wait in the queue meanwhile.
BANK_PAYOUT_PROVIDER=
# Largest single bank payment (KSh), if your bank sets one.
PAYROLL_BANK_MAX_AMOUNT=
